# ==========================================
# VeriResume Environment Variables
# ==========================================
# Copy this file to .env.local for local development
# For Vercel deployment, add these in Vercel Dashboard > Settings > Environment Variables

# Google Gemini API Key (REQUIRED)
# Get yours at: https://aistudio.google.com/app/apikey
# Must start with 'AIza'
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (REQUIRED for database features)
# Get these from your Supabase project dashboard > Settings > API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Optional: Supabase Service Role Key (for admin operations)
# WARNING: Keep this secret! Never expose in frontend code.
SUPABASE_SERVICE_KEY=your_supabase_service_key_here
